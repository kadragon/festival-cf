    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
